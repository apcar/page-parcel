{
  "name": "pageparcel",
  "version": "0.2.0",
  "description": "Local-first web capture with screenshots, Markdown, metadata, and integrity hashes.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "author": "Andrew Greene <https://github.com/apcar>",
  "repository": {
    "type": "git",
    "url": "https://github.com/apcar/page-parcel.git"
  },
  "homepage": "https://github.com/apcar/page-parcel#readme",
  "bugs": "https://github.com/apcar/page-parcel/issues",
  "keywords": [
    "chrome-extension",
    "screenshot",
    "web-capture",
    "markdown",
    "local-first",
    "provenance"
  ],
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run icons && tsc --noEmit && vite build",
    "package": "npm run build"
  },
  "dependencies": {
    "defuddle": "0.19.1",
    "fflate": "0.8.3",
    "preact": "^10.29.4",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.2.2",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "linkedom": "^0.18.13",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
